      "File \u001b[0;32m~/.pyenv/versions/3.10.8/lib/python3.10/site-packages/joblib/executor.py:11\u001b[0m\n\u001b[1;32m      1\u001b[0m \u001b[38;5;124;03m\"\"\"Utility function to construct a loky.ReusableExecutor with custom pickler.\u001b[39;00m\n\u001b[1;32m      2\u001b[0m \n\u001b[1;32m      3\u001b[0m \u001b[38;5;124;03mThis module provides efficient ways of working with data stored in\u001b[39;00m\n\u001b[1;32m      4\u001b[0m \u001b[38;5;124;03mshared memory with numpy.memmap arrays without inducing any memory\u001b[39;00m\n\u001b[1;32m      5\u001b[0m \u001b[38;5;124;03mcopy between the parent and child processes.\u001b[39;00m\n\u001b[1;32m      6\u001b[0m \u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m      7\u001b[0m \u001b[38;5;66;03m# Author: Thomas Moreau <thomas.moreau.2010@gmail.com>\u001b[39;00m\n\u001b[1;32m      8\u001b[0m \u001b[38;5;66;03m# Copyright: 2017, Thomas Moreau\u001b[39;00m\n\u001b[1;32m      9\u001b[0m \u001b[38;5;66;03m# License: BSD 3 clause\u001b[39;00m\n\u001b[0;32m---> 11\u001b[0m \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01m.\u001b[39;00m\u001b[38;5;21;01m_memmapping_reducer\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;28;01mimport\u001b[39;00m TemporaryResourcesManager, get_memmapping_reducers\n\u001b[1;32m     12\u001b[0m \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01m.\u001b[39;00m\u001b[38;5;21;01mexternals\u001b[39;00m\u001b[38;5;21;01m.\u001b[39;00m\u001b[38;5;21;01mloky\u001b[39;00m\u001b[38;5;21;01m.\u001b[39;00m\u001b[38;5;21;01mreusable_executor\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;28;01mimport\u001b[39;00m _ReusablePoolExecutor\n\u001b[1;32m     14\u001b[0m _executor_args \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;01mNone\u001b[39;00m\n",
